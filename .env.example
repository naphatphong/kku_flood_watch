# Copy to .env.local and fill in what you need. With nothing set the app runs in demo mode
# (live rain from Open-Meteo, sample posts). Full setup: docs/SETUP.md

# --- Supabase (database, auth, realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only, never expose to the browser

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDERS=google            # e.g. google,custom:line

# --- Scheduled refresh (pg_cron calls /api/cron/refresh with this bearer token) ---
CRON_SECRET=

# --- Optional features (each stays hidden until its key is set) ---
NEXT_PUBLIC_MAPTILER_KEY=       # satellite imagery
NEXT_PUBLIC_TOMTOM_KEY=         # live traffic
ANTHROPIC_API_KEY=              # read timetable screenshots
